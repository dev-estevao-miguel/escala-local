# Copie para .env. Não publique este arquivo com credenciais preenchidas.
ADMIN_LOGIN=900001
# ADMIN_PASSWORD pode ser usado; ADMIN_SENHA existente continua aceito.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_AQUI
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Connect → Transaction pooler. Use a URI completa com sslmode=verify-full.
DATABASE_URL=
# TLS e validação do certificado são obrigatórios. Se necessário, use o CA oficial do Supabase.
# Cole o PEM com quebras de linha escapadas como \n; não desative a verificação TLS.
DATABASE_SSL_CA=
# Carteira do administrador: 900001. Defina uma senha própria (mínimo 10 caracteres).
ADMIN_SENHA=
# Segredo aleatório para sessões (mínimo 32 caracteres).
SESSAO_SEGREDO=
# Sem usuários fictícios no desenvolvimento:
SEM_DEMO=1
